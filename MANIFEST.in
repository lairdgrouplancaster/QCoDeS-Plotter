include Agents.md
include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include README.md
include pyproject.toml
include setup.py
include src/qplot/datahandling/_trusted_vfs_native.c
include src/qplot/datahandling/_trusted_vfs_sqlite_abi.h

graft docs
graft scripts
graft src
graft tests

prune .mypy_cache
prune .pytest_cache
prune .ruff_cache
prune .venv
prune .venv-mac
prune .venv-linux
prune .venv-win
prune build
prune dist
prune htmlcov
prune other
prune src/qplot.egg-info

global-exclude .DS_Store
global-exclude *.py[cod]
global-exclude *.dll
global-exclude *.dylib
global-exclude *.pyd
global-exclude *.so
global-exclude .coverage
global-exclude coverage.xml
