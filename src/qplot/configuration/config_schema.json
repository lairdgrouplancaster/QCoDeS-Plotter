{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        
        "GUI": {
            "type": "object",
            "properties": {
                "plot_frame_fraction": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1,
                    "default": 0.47
                },
                "main_frame_size": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16777215
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "default": [780, 700]
                },
                "preview_size": {
                    "type": "integer",
                    "minimum": 50,
                    "maximum": 1000,
                    "default": 200
                },
                "run_table_column_widths": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 32,
                        "maximum": 16777215
                    },
                    "oneOf": [
                        { "maxItems": 0 },
                        { "minItems": 12, "maxItems": 12 }
                    ],
                    "default": []
                },
                "run_table_visible_columns": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "run_id",
                            "experiment",
                            "sample",
                            "measurements",
                            "setpoints",
                            "name",
                            "started",
                            "completed",
                            "status",
                            "duration",
                            "size",
                            "guid"
                        ]
                    },
                    "uniqueItems": true,
                    "maxItems": 12,
                    "default": [
                        "run_id",
                        "measurements",
                        "setpoints",
                        "started",
                        "status",
                        "duration",
                        "size"
                    ]
                }
            },
            "required": [
                "plot_frame_fraction",
                "main_frame_size",
                "preview_size",
                "run_table_column_widths",
                "run_table_visible_columns"
            ],
            "additionalProperties": false
        },
        
        "file": {
            "type": "object",
            "properties": {
                "default_load_path": {
                    "type": "string",
                    "default": ""
                },
                "recent_file_paths": {
                    "type": "array",
                    "items": { "type": "string" },
                    "uniqueItems": true,
                    "maxItems": 10,
                    "default": []
                }
            },
            "required": ["default_load_path", "recent_file_paths"],
            "additionalProperties": false
        },
        
        "user_preference": {
            "type": "object",
            "properties": {
                "theme":{
                    "type": "string",
                    "enum": ["light", "dark", "pyqt"],
                    "default": "light"
                },
                "bar_colour" : {
                    "type": "string",
                    "default": "viridis"
                },
                "colorbar_width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500,
                    "default": 15
                },
                "axis_tick_width": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 10,
                    "default": 2
                },
                "axis_major_tick_count": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 10,
                    "default": 3
                },
                "bar_colour_include_cet": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_matplotlib": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_local": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_custom": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_cet_linear": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_cet_divergent": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_cet_cyclic": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_cet_rainbow": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_cet_isoluminant": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_cet_other": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_matplotlib_perceptual": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_matplotlib_sequential": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_matplotlib_divergent": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_matplotlib_cyclic": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_matplotlib_qualitative": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_include_matplotlib_other": {
                    "type": "boolean",
                    "default": true
                },
                "bar_colour_excluded": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": []
                },
                "bar_colour_excluded_prefixes": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": []
                },
                "confirm_close": {
                    "type": "boolean",
                    "default": true
                },
                "confirm_close_all": {
                    "type": "boolean",
                    "default": true
                },
                "mouse_mode": {
                    "type": "string",
                    "enum": ["pan", "rect"],
                    "default": "pan"
                },
                "copy_plot_image_resolution": {
                    "type": "string",
                    "enum": ["screen", "dpi_300", "svg"],
                    "default": "screen"
                },
                "auto_plot": {
                    "type": "boolean",
                    "default": false
                },
                "default_refresh_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 86400,
                    "default": 1
                }
            },
            "required": [
                "theme",
                "bar_colour",
                "colorbar_width",
                "axis_tick_width",
                "axis_major_tick_count",
                "bar_colour_include_cet",
                "bar_colour_include_matplotlib",
                "bar_colour_include_local",
                "bar_colour_include_custom",
                "bar_colour_include_cet_linear",
                "bar_colour_include_cet_divergent",
                "bar_colour_include_cet_cyclic",
                "bar_colour_include_cet_rainbow",
                "bar_colour_include_cet_isoluminant",
                "bar_colour_include_cet_other",
                "bar_colour_include_matplotlib_perceptual",
                "bar_colour_include_matplotlib_sequential",
                "bar_colour_include_matplotlib_divergent",
                "bar_colour_include_matplotlib_cyclic",
                "bar_colour_include_matplotlib_qualitative",
                "bar_colour_include_matplotlib_other",
                "bar_colour_excluded",
                "bar_colour_excluded_prefixes",
                "confirm_close",
                "confirm_close_all",
                "mouse_mode",
                "copy_plot_image_resolution",
                "auto_plot",
                "default_refresh_rate"
            ],
            "additionalProperties": false
        },
        
        "runtime_settings": {
            "type": "object",
            "properties": {
                "max_threads": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 999,
                    "default": 4
                },
                "max_full_heatmap_points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2000000000,
                    "default": 2000000
                },
                "del_grace_period": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 300,
                    "default": 10
                },
                "cloud_sync_timeout": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 3600,
                    "default": 120
                }
             },
             "required": ["max_threads", "max_full_heatmap_points", "del_grace_period", "cloud_sync_timeout"],
             "additionalProperties": false 
        }
    },
    "required": ["GUI", "file", "user_preference", "runtime_settings"],
    "additionalProperties": false
}
